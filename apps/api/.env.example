# A API inicial é apenas para desenvolvimento local.
PORT=3333
# Crie primeiro um banco exclusivo e um usuário próprio para o Expert.
# Copie este arquivo para .env e preencha a senha localmente (codificada para URL).
# DATABASE_URL=postgresql://expert_app_dev:SENHA@127.0.0.1:5432/expert_erp_dev
DATABASE_EXPECTED_NAME=expert_erp_dev
